{
  "name": "marelle-desktop",
  "version": "3.6.7-sierra.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "npm run build && electron .",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.*",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run check:main && npm test && npm run build && electron-builder --mac dmg zip --x64 --publish never",
    "pack": "npm run build && electron-builder --dir",
    "check:main": "node --check electron/main.cjs && node --check electron/preload.cjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "electron": "19.1.9",
    "electron-builder": "^26.18.0",
    "vite": "^7.0.0"
  },
  "description": "Semainier et préparations de classe hors ligne",
  "author": "Marelle",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.marelle.desktop",
    "productName": "Marelle",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "build-resources/icon.png",
      "resources.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build-resources/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.education",
      "icon": "build-resources/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "minimumSystemVersion": "10.12.0",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "sign": false,
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ],
      "filesystem": "HFS+",
      "format": "UDZO"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build-resources/icon.ico",
      "uninstallerIcon": "build-resources/icon.ico"
    }
  }
}
